{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":automergeRequireAllStatusChecks",
    "security:minimumReleaseAgePypi"
  ],

  "dependencyDashboard": true,

  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },

  "packageRules": [
    {
      "description": "Automerge stable patch and minor updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },

    {
      "description": "Automerge development dependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },

    {
      "description": "Automerge formatting and linting tools",
      "matchPackageNames": [
        "ruff",
        "prettier",
        "eslint",
        "eslint-*"
      ],
      "automerge": true
    },
    
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
